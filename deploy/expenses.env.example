# Секреты и настройки бэкенда Expenses.
# На сервере лежит как /etc/expenses/expenses.env (chmod 600), подключается через
# systemd (EnvironmentFile=). Скопируй этот файл в expenses.env и подставь значения.
# РЕАЛЬНЫЕ значения в git НЕ коммитить — только этот шаблон.

# --- Подключение к PostgreSQL (контейнер expenses-pg на 127.0.0.1:5432) ---
DB_URL=jdbc:postgresql://localhost:5432/expenses
DB_USER=postgres
DB_PASSWORD=<пароль_БД>

# --- Telegram-бот (@BotFather) ---
BOT_TOKEN=<токен_бота>

# --- Токен «владельца»: им входишь в приложение/веб, к нему привязаны старые траты ---
# Любая длинная случайная строка. Сгенерировать: `openssl rand -hex 32`
API_TOKEN=<длинный_случайный_токен>

# --- Groq (ИИ-категоризация). Необязателен: без ключа траты остаются без ---
#     обобщённой категории, всё остальное работает. ---
GROQ_API_KEY=<ключ_groq>
# GROQ_MODEL=openai/gpt-oss-20b   # (необязательно) переопределить модель
