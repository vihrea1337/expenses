# Caddy терминирует HTTPS на порту 34443 и проксирует в Ktor.
# Сертификат выпускается автоматически через DNS-проверку DuckDNS (порт 80/443 НЕ нужен).
vihreaexpenses.duckdns.org:34443 {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}

	# Сборки приложения (APK) — файлы из папки ./downloads на сервере (монтируется
	# в /srv/download, см. docker-compose.yml). В jar их не кладём: APK весит ~11 МБ,
	# и новую сборку можно выложить без пересборки бэкенда. Ссылка на странице
	# install.html — /download/Expenses.apk (имя постоянное).
	handle /download/* {
		root * /srv
		# Тип файла явно: иначе браузер на Android может сохранить APK как «.bin».
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header Cache-Control "no-cache"
		file_server
	}

	# Всё остальное — бэкенд (веб-страница, REST API, health).
	handle {
		reverse_proxy expenses-backend:8080
	}
}
