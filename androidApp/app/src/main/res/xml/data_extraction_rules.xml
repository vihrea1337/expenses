<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: что можно копировать в облако и на новый телефон. Ничего: токен доступа
     и кэш трат — личные данные; на новом телефоне всё и так придёт с сервера после входа. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
