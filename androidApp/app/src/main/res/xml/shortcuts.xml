<?xml version="1.0" encoding="utf-8"?>
<!-- Статичные ярлыки: долгое нажатие на значок приложения → «Добавить трату».
     Ярлык открывает MainActivity с действием ADD_EXPENSE — она сразу показывает
     окно быстрого ввода (см. MainActivity.handleIntent). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="io.github.vihrea1337.expenses.ADD_EXPENSE"
            android:targetPackage="io.github.vihrea1337.expenses"
            android:targetClass="io.github.vihrea1337.expenses.android.MainActivity" />
    </shortcut>
</shortcuts>
